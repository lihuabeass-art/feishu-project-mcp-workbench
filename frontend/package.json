{
  "name": "fstodo-desktop",
  "private": true,
  "version": "0.4.3",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "build:windows": "node scripts/tauri.mjs build -- --locked",
    "build:windows:beta": "npm run build:windows",
    "build:macos": "node scripts/tauri.mjs build --target universal-apple-darwin -- --locked",
    "preview": "vite preview --host 127.0.0.1",
    "test": "npm run test:release && vitest run src --maxWorkers=1",
    "test:release": "node --test scripts/*.test.mjs",
    "release:notes": "node scripts/release-notes.mjs",
    "format": "prettier --write src vite.config.ts",
    "tauri": "node scripts/tauri.mjs"
  },
  "dependencies": {
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@tauri-apps/api": "2.11.1",
    "@tauri-apps/plugin-process": "2.3.0",
    "@tauri-apps/plugin-updater": "2.9.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "typescript": "~5.9.3",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  }
}
