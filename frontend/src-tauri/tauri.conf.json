{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FSTODO",
  "version": "0.0.0-dev",
  "identifier": "cn.fstodo.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist",
    "additionalWatchFolders": ["../../backend"]
  },
  "app": {
    "windows": [
      {
        "title": "FSTODO · 飞书个人工作台",
        "width": 1240,
        "height": 800,
        "minWidth": 760,
        "minHeight": 580,
        "center": true,
        "visible": false,
        "dragDropEnabled": false,
        "transparent": true,
        "backgroundColor": "#f3f5f3e8",
        "windowEffects": { "effects": ["mica"] }
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEJBOTgyRUUwRDEzRDYxODIKUldTQ1lUM1I0QzZZdXNiSmVQUmYxYit3cTRNMHg3ZWJ6ZktsV1dwL2RzTGZDYmJPWmFBVWNISlAK",
      "endpoints": [],
      "windows": { "installMode": "passive" }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "resources": {
      "../../LICENSE": "licenses/LICENSE",
      "../../THIRD_PARTY_NOTICES.md": "licenses/THIRD_PARTY_NOTICES.md"
    },
    "icon": ["icons/32x32.png", "icons/256x256.png", "icons/icon.ico"],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" }
    }
  }
}
